{
  "name": "noidle-resume",
  "private": true,
  "version": "0.1.0",
  "description": "GLM Coding Plan 限额到点后，自动续跑 VS Code 侧边栏 Claude Code 会话的本地工具",
  "type": "module",
  "workspaces": [
    "apps/server",
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "npm run dev -w @noidle/resume-server",
    "dev:web": "npm run dev -w @noidle/resume-web",
    "build": "npm run build -w @noidle/resume-web",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build:sidecar:win": "node scripts/build-sidecar.mjs --windows",
    "build:desktop": "npm run build && npm run build:sidecar && cd apps/desktop && npx tauri build",
    "start": "npm run start -w @noidle/resume-server",
    "typecheck": "tsc -p packages/contracts --noEmit && tsc -p apps/server --noEmit && npm run typecheck -w @noidle/resume-web",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "playwright-core": "^1.64.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
