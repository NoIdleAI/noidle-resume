{
  "name": "noidle-resume",
  "private": true,
  "version": "0.1.0",
  "description": "GLM 5 小时限额后自动续跑 VS Code 侧边栏 Claude Code 会话的本地工具（设计书：限额恢复设计方案01.md）",
  "type": "module",
  "workspaces": [
    "apps/server",
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "npm run dev -w @noidle/resume-server",
    "dev:web": "npm run dev -w @noidle/resume-web",
    "build": "npm run build -w @noidle/resume-web",
    "start": "npm run start -w @noidle/resume-server",
    "typecheck": "tsc -p packages/contracts --noEmit && tsc -p apps/server --noEmit && npm run typecheck -w @noidle/resume-web",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
